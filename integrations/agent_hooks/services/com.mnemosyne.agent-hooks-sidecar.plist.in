<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mnemosyne.agent-hooks-sidecar</string>
  <key>ProgramArguments</key>
  <array>
    <string>@MNEMOSYNE_PYTHON@</string>
    <string>-I</string>
    <string>@MNEMOSYNE_SIDECAR_LAUNCHER@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
</dict>
</plist>
